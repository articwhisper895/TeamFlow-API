{
  "info": {
    "_postman_id": "a4f6d5a7-1be4-4b09-b57b-3a9cce4b58d1",
    "name": "TeamFlow API",
    "description": "Manual API smoke tests. Register or log in first, then create a project and exercise the project/task routes. Register the Grace Hopper teammate once before using Add project member. If the account already exists, skip that registration request. Refresh tokens are single-use: Refresh tokens (rotates) replaces the stored refreshToken, and reusing an old one revokes that session. Logout (revoke this session) ends only the session whose refresh token is sent.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "memberEmail",
      "value": "grace@example.com"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const data = pm.response.json().data;",
              "  pm.collectionVariables.set('accessToken', data.access_token);",
              "  pm.collectionVariables.set('refreshToken', data.refresh_token);",
              "  pm.collectionVariables.set('memberId', data.user.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"ada@example.com\",\n  \"password\": \"CorrectHorse123!\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data;",
              "  pm.collectionVariables.set('accessToken', data.access_token);",
              "  pm.collectionVariables.set('refreshToken', data.refresh_token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"CorrectHorse123!\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/me"
      }
    },
    {
      "name": "Refresh tokens (rotates)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data;",
              "  pm.collectionVariables.set('accessToken', data.access_token);",
              "  pm.collectionVariables.set('refreshToken', data.refresh_token);",
              "  console.log('Refresh token rotated for session', data.session_id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{refreshToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/refresh"
      }
    },
    {
      "name": "Logout (revoke this session)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  console.log('Revoked session', pm.response.json().data.session_id);",
              "  pm.collectionVariables.set('accessToken', '');",
              "  pm.collectionVariables.set('refreshToken', '');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{refreshToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/logout"
      }
    },
    {
      "name": "Create project",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('projectId', pm.response.json().data.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Website launch\",\n  \"description\": \"Coordinate the new company website.\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects"
      }
    },
    {
      "name": "Register teammate (run once)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('memberId', pm.response.json().data.user.id); }",
              "else if (pm.response.code === 409) { console.log('Teammate already exists; continue to Add project member.'); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Grace Hopper\",\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"CorrectHorse123!\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "List projects",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/projects?page=1&limit=20"
      }
    },
    {
      "name": "Add project member",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('memberId', pm.response.json().data.user_id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{memberEmail}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/members"
      }
    },
    {
      "name": "Create task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('taskId', pm.response.json().data.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Prepare landing page copy\",\n  \"description\": \"Draft and review the first version.\",\n  \"priority\": \"high\",\n  \"assigned_to_id\": {{memberId}},\n  \"due_date\": \"2026-12-01\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks"
      }
    },
    {
      "name": "List tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks?page=1&limit=20"
      }
    }
  ]
}
