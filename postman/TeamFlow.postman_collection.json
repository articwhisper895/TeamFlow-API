{
  "info": {
    "_postman_id": "a4f6d5a7-1be4-4b09-b57b-3a9cce4b58d1",
    "name": "TeamFlow API",
    "description": "Manual walkthrough of the API. Run the requests in order on a fresh database. Test scripts store the access token, refresh token and created ids as collection variables. Refresh tokens (rotates) replaces both stored tokens; Logout (revoke this session) is last because it revokes the session and clears them. The accounts and passwords here are test data only.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:5000"
    },
    {
      "key": "accessToken",
      "value": ""
    },
    {
      "key": "refreshToken",
      "value": ""
    },
    {
      "key": "projectId",
      "value": ""
    },
    {
      "key": "memberId",
      "value": ""
    },
    {
      "key": "taskId",
      "value": ""
    },
    {
      "key": "memberEmail",
      "value": "grace@example.com"
    }
  ],
  "item": [
    {
      "name": "Health",
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/api/health"
      }
    },
    {
      "name": "Register",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) {",
              "  const data = pm.response.json().data;",
              "  pm.collectionVariables.set('accessToken', data.access_token);",
              "  pm.collectionVariables.set('refreshToken', data.refresh_token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Ada Lovelace\",\n  \"email\": \"ada@example.com\",\n  \"password\": \"CorrectHorse123!\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data;",
              "  pm.collectionVariables.set('accessToken', data.access_token);",
              "  pm.collectionVariables.set('refreshToken', data.refresh_token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"ada@example.com\",\n  \"password\": \"CorrectHorse123!\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/login"
      }
    },
    {
      "name": "Current user",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/me"
      }
    },
    {
      "name": "Refresh tokens (rotates)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  const data = pm.response.json().data;",
              "  pm.collectionVariables.set('accessToken', data.access_token);",
              "  pm.collectionVariables.set('refreshToken', data.refresh_token);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{refreshToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/refresh"
      },
      "description": "Single-use rotation. This replaces BOTH stored tokens: the test script saves the new access and refresh tokens. Running it again with the previous refresh token returns 401 refresh_token_reused and revokes this session, so treat a lost response as a reason to sign in again."
    },
    {
      "name": "Create project",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('projectId', pm.response.json().data.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Website launch\",\n  \"description\": \"Coordinate the new company website.\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects"
      }
    },
    {
      "name": "Register teammate (run once)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('memberId', pm.response.json().data.user.id); }",
              "else if (pm.response.code === 409) { console.log('Teammate already exists; continue to Add project member.'); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Grace Hopper\",\n  \"email\": \"{{memberEmail}}\",\n  \"password\": \"CorrectHorse123!\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/auth/register"
      }
    },
    {
      "name": "List projects",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/projects?page=1&limit=20"
      }
    },
    {
      "name": "Add project member",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('memberId', pm.response.json().data.user_id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{memberEmail}}\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/members"
      }
    },
    {
      "name": "List project members",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "const members = pm.response.json().data || [];",
              "const email = pm.collectionVariables.get('memberEmail');",
              "const match = members.find((member) => member.email === email);",
              "if (match) { pm.collectionVariables.set('memberId', match.user_id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/members"
      }
    },
    {
      "name": "Create task",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 201) { pm.collectionVariables.set('taskId', pm.response.json().data.id); }"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          },
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Prepare landing page copy\",\n  \"description\": \"Draft and review the first version.\",\n  \"priority\": \"high\",\n  \"assigned_to_id\": {{memberId}},\n  \"due_date\": \"2026-12-01\"\n}"
        },
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks"
      }
    },
    {
      "name": "List tasks",
      "request": {
        "method": "GET",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{accessToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/projects/{{projectId}}/tasks?page=1&limit=20"
      }
    },
    {
      "name": "Logout (revoke this session)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "if (pm.response.code === 200) {",
              "  pm.collectionVariables.set('accessToken', '');",
              "  pm.collectionVariables.set('refreshToken', '');",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Authorization",
            "value": "Bearer {{refreshToken}}"
          }
        ],
        "url": "{{baseUrl}}/api/v1/auth/logout"
      },
      "description": "Run this last. Revokes only the session whose refresh token is sent, then clears the stored tokens after a confirmed 200 response. Other sessions stay signed in."
    }
  ]
}
